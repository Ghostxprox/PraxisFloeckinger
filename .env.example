# Kopiere diese Datei nach .env und setze lokale Werte.
# .env wird NICHT committet (steht in .gitignore).

# Postgres-Passwort für lokale Entwicklung (muss mit appsettings.Development.json übereinstimmen)
POSTGRES_PASSWORD=change_me_local_dev_only

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
